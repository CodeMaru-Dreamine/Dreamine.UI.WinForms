<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[Dreamine.UI.WinForms]*</Include>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**,**/Controls/**,**/MessageBox/**,**/Popup/**,**/VirtualKeyboard/DreamineVirtualKeyboard*.cs,**/VirtualKeyboard/ImeHelper.cs</ExcludeByFile>
          <UseSourceLink>false</UseSourceLink>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
